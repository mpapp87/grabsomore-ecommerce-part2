# Copy this file to .env beside manage.py. Replace mock values before real use.
# The defaults below run locally with SQLite and print email to the terminal.
DJANGO_SECRET_KEY=development-only-replace-with-a-generated-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# For MySQL, change DB_ENGINE to mysql and replace DB_PASSWORD.
DB_ENGINE=sqlite
DB_NAME=ecommerce_db
DB_USER=ecommerce_user
DB_PASSWORD=replace-with-your-local-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Switch to django.core.mail.backends.smtp.EmailBackend for real email.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=replace-with-your-smtp-password
DEFAULT_FROM_EMAIL=no-reply@example.com
